# ~/agent/zephyr.toml (or $ZEPHYR_CONFIG)
rpi = "/home/zephyr/rpi/current/bin/rpi"   # pinned rpi 0.12.x; check with `zephyr doctor`
home = "/home/zephyr/agent"                # state.db, sessions/, zephyr.sock; the child's cwd
agent_dir = "/home/zephyr/.rpi/agent"      # RPI_CODING_AGENT_DIR: models.json and credentials
model = "anthropic/claude-sonnet-5"
# policy_plugin = "/home/zephyr/lib/libzephyr_policy.so"   # refuse prompts unless it loads

# Optional DM-only Discord adapter. Remove this table to run chat-only.
# [discord]
# token_env = "ZEPHYR_DISCORD_TOKEN"   # env var holding the bot token; the token never goes in this file

[owners]
chat = ["1000"]   # uids allowed on the unix socket
# discord = ["123456789012345678"]   # Discord user ids allowed to DM the agent

# Attach the stock TUI to the live session: RPI_SERVER_TOKEN=... rpi --connect 127.0.0.1:7790
# Listens on 127.0.0.1 only. Detaching (client exit, stop_session) never stops the agent.
# [attach]
# port = 7790
# token_file = "/home/zephyr/agent/tui.token"   # mode 0600; or token_env = "ZEPHYR_TUI_TOKEN"
