# ~/agent/zephyr.toml (or $ZEPHYR_CONFIG)
rpi = "/home/zephyr/rpi/current/bin/rpi"   # pinned rpi 0.12.x; check with `zephyr doctor`
home = "/home/zephyr/agent"                # state.db, sessions/, zephyr.sock; the child's cwd
agent_dir = "/home/zephyr/.rpi/agent"      # RPI_CODING_AGENT_DIR: models.json and credentials
model = "anthropic/claude-sonnet-5"
# policy_plugin = "/home/zephyr/lib/libzephyr_policy.so"   # refuse prompts unless it loads

[owners]
chat = ["1000"]   # uids allowed on the unix socket
