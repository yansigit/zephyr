# ~/.zephyr/zephyr.toml, seen as /zephyr/zephyr.toml in the container (`zephyr init` writes it; edit with `zephyr config set`)
rpi = "/usr/local/bin/rpi"   # pinned rpi 0.12.x; check with `zephyr doctor`
home = "/zephyr"                      # state.db, sessions/, zephyr.sock; the child's cwd
agent_dir = "/zephyr/.rpi/agent"      # RPI_CODING_AGENT_DIR: models.json and credentials
model = "anthropic/claude-sonnet-5"
# policy_plugin = "/usr/local/lib/libzephyr_policy.so"   # refuse prompts unless it loads
# extensions = ["/opt/zephyr/ext/librpi_providers.so", "/opt/zephyr/ext/rpi-cursor-lite/librpi_cursor_lite.so", "/opt/zephyr/ext/rpi-claude-agent/librpi_claude_agent.so"]   # baked into the image; each loads with --extension after policy_plugin
# timezone = "Asia/Seoul"   # IANA zone for /job cron schedules; default: the system time zone

# Optional DM-only Discord adapter. Remove this table to run chat-only.
# [discord]
# token_env = "ZEPHYR_DISCORD_TOKEN"   # env var holding the bot token, set in ~/.zephyr/secrets.env (`zephyr channel add discord`)
# progress = true            # post a "≋ working · 0:24 · bash" note while a run is long; typing shows either way
# progress_after_secs = 20   # how long a run goes before the note is posted

# Optional iMessage via BlueBubbles on your Mac (DESIGN §4.3). Register the webhook in BlueBubbles as
# http://<listen>/?secret=<secret>. Messages from the last lookback_hours are re-read at start.
# [imessage]
# listen = "100.x.y.z:7791"               # this host's Tailscale IP; 0.0.0.0 is refused
# server_url = "http://100.a.b.c:1234"     # the Mac's BlueBubbles server
# password_env = "ZEPHYR_BB_PASSWORD"
# secret_env = "ZEPHYR_BB_SECRET"

# Account pool (DESIGN §4.9), in failover order; replaces `model` when present. Each account's
# credentials live in <home>/accounts/<name>/ (its own RPI_CODING_AGENT_DIR); models.json and
# settings.json are linked from agent_dir. A rate-limited account cools down and the next one takes over.
# [[account]]
# name = "codex-main"
# model = "openai-codex/gpt-5.5"
# [[account]]
# name = "claude-max"
# model = "claude-code/claude-opus-5-5"

# OAuth refresh until upstream PR #144 lands (DESIGN §4.7). Defaults shown.
# [auth]
# enabled = true
# refresh_minutes = 10

[owners]
chat = ["1000"]   # uids allowed on the unix socket
# discord = ["123456789012345678"]   # Discord user ids allowed to DM the agent
# imessage = ["+15551234567", "you@icloud.com"]   # iMessage handles allowed to message the agent

# Attach the stock TUI to the live session: RPI_SERVER_TOKEN=... rpi --connect 127.0.0.1:7790
# Listens on 127.0.0.1 only. Detaching (client exit, stop_session) never stops the agent.
# [attach]
# port = 7790
# token_file = "/zephyr/tui.token"   # mode 0600; or token_env = "ZEPHYR_TUI_TOKEN"
